# ==============================================================================
# TradeWise Environment Configuration
# ==============================================================================

# Backend Configuration
ENV=development
LOG_LEVEL=INFO
APP_NAME=TradeWise
APP_VERSION=1.0.0

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://tradewise:tradewise123@localhost:5432/tradewise

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=change-me-to-a-secure-random-secret-key-32-chars-minimum
JWT_EXPIRY_MINUTES=60

# CORS Allowed Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External API Keys
FINNHUB_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
